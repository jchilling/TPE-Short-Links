# Local development (Docker Compose)
DATABASE_URL="postgresql+psycopg://tpe_admin:<PASSWORD>@localhost:5432/tpe_short_links"
ALLOW_HTTP_URLS=false
SHORTLINK_CODE_LENGTH=4
# Comma-separated reserved codes that are always blocked (in addition to DB table)
RESERVED_CODES=api,docs,admin,health,metrics
PUBLIC_BASE_URL=http://localhost:8000

# Firebase (optional; if set, all /api/* routes require a valid Firebase ID token)
# Leave empty for local dev without auth.
# Production: set FIREBASE_PROJECT_ID to your Firebase Project ID (this matches the ID token `aud` claim).
# FIREBASE_PROJECT_ID=your-project-id
#
# Optional (NOT used for backend verification): Web app App ID (useful for reference / debugging).
# FIREBASE_APP_ID=1:123456789:web:abcdef

# ============================================================
# Production (Cloud SQL) - Copy to .env.production
# ============================================================
# For Cloud SQL with Unix socket (Cloud Run):
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@/DATABASE_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
#
# For Cloud SQL with public IP (local migration):
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@PUBLIC_IP:5432/DATABASE_NAME
#
# Example for doit-dic-itteam project:
# DATABASE_URL=postgresql+psycopg://tpe_admin:YOUR_PASSWORD@/tpe_short_links?host=/cloudsql/doit-dic-itteam:asia-east1:tpe-shortlinks-db
# PUBLIC_BASE_URL=https://api.url.taipei (or your Cloud Run URL)
